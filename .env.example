# Google Gemini API Key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Or OpenAI API Key (optional, fallback)
# OPENAI_API_KEY=your_openai_api_key_here

# ── Offline fallback models (standby; the APIs above stay the main path) ──
# Loaded in the background at startup. Set to 0 to skip loading them.
LOCAL_AI_PRELOAD=1
# Whisper: large-v3-turbo on GPU (float16), small on CPU (int8)
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_MODEL=small
# PhoBERT bi-encoder for meaning-based dictionary lookup
PHOBERT_MODEL=bkai-foundation-models/vietnamese-bi-encoder
PHOBERT_THRESHOLD=0.75
